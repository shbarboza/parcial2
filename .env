PORT=3000

# Variable para seleccionar el motor de base de datos: mysql, postgres

DB_ENGINE=mysql

# Configuración para MySQL
MYSQL_HOST=localhost 
MYSQL_USER=admin
MYSQL_PASSWORD=password # contraseña de tu mysql
MYSQL_NAME=almacen_2025_iisem_node # configura el nombre de tu base de datos creada aqui
MYSQL_PORT=3306

# Configuración para PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_NAME=almacen_2025_iisem_node
POSTGRES_PORT=5432

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
