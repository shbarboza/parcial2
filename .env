PORT=3000

# Variable para seleccionar el motor de base de datos: mysql, postgres

DB_ENGINE=mysql

# Configuración para MySQL
MYSQL_HOST=172.24.203.81
MYSQL_USER=root
MYSQL_PASSWORD=root1234 # contraseña de tu mysql
MYSQL_NAME=cars_db # configura el nombre de tu base de datos creada aqui
MYSQL_PORT=3307

# Configuración para PostgreSQL
# POSTGRES_HOST=localhost
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=admin1234
# POSTGRES_NAME=cars_db
# POSTGRES_PORT=5432

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
